#!/usr/bin/env python3
"""
meridian-welcome
Pantalla de bienvenida de Meridian OS. Se abre al iniciar sesion y ofrece
las acciones mas comunes: instalar el sistema, conectarse a una red,
abrir el navegador o la suite de oficina.
"""
import os
import subprocess

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

AUTOSTART = os.path.expanduser("~/.config/autostart/meridian-welcome.desktop")

CSS = b"""
window { background-color: #0d1526; }
label.title { color: #ffffff; font-size: 26px; font-weight: bold; }
label.subtitle { color: #8fa6c4; font-size: 13px; }
button.card {
    background-image: none;
    background-color: #17233c;
    border: 1px solid #253császár;
    border-radius: 8px;
    padding: 14px;
}
"""

# Nota: la linea de borde de arriba se corrige en tiempo de ejecucion.
CSS = CSS.replace("#253császár".encode(), b"#25324d")

ACCIONES = [
    ("Instalar Meridian OS",
     "Copia el sistema a tu disco duro.",
     ["calamares"]),
    ("Conectar a una red",
     "Configura WiFi o red cableada.",
     ["nm-connection-editor"]),
    ("Navegar por internet",
     "Abre Firefox.",
     ["firefox-esr"]),
    ("Abrir LibreOffice",
     "Documentos, hojas de calculo y presentaciones.",
     ["libreoffice"]),
]


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Bienvenido a Meridian OS")
        self.set_default_size(620, 440)
        self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        caja.set_margin_top(28)
        caja.set_margin_bottom(22)
        caja.set_margin_start(28)
        caja.set_margin_end(28)
        self.add(caja)

        titulo = Gtk.Label(label="Bienvenido a Meridian OS")
        titulo.get_style_context().add_class("title")
        titulo.set_xalign(0)
        caja.pack_start(titulo, False, False, 0)

        sub = Gtk.Label(label="Estas usando el sistema en modo de prueba. "
                              "Nada se guarda hasta que lo instales.")
        sub.get_style_context().add_class("subtitle")
        sub.set_xalign(0)
        sub.set_line_wrap(True)
        caja.pack_start(sub, False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=12,
                        column_homogeneous=True)
        caja.pack_start(grid, True, True, 8)

        for i, (nombre, desc, cmd) in enumerate(ACCIONES):
            grid.attach(self._tarjeta(nombre, desc, cmd), i % 2, i // 2, 1, 1)

        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        caja.pack_start(pie, False, False, 0)

        self.check = Gtk.CheckButton(label="No mostrar esto al iniciar")
        self.check.get_style_context().add_class("subtitle")
        self.check.connect("toggled", self._alternar_autostart)
        pie.pack_start(self.check, False, False, 0)

        cerrar = Gtk.Button(label="Cerrar")
        cerrar.connect("clicked", lambda _w: Gtk.main_quit())
        pie.pack_end(cerrar, False, False, 0)

        self.connect("destroy", Gtk.main_quit)

    def _tarjeta(self, nombre, desc, cmd):
        boton = Gtk.Button()
        boton.get_style_context().add_class("card")

        interior = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        t = Gtk.Label(label=nombre)
        t.set_xalign(0)
        t.set_markup('<span foreground="#ffffff" weight="bold">%s</span>' % nombre)
        d = Gtk.Label(label=desc)
        d.set_xalign(0)
        d.set_line_wrap(True)
        d.set_markup('<span foreground="#8fa6c4" size="small">%s</span>' % desc)
        interior.pack_start(t, False, False, 0)
        interior.pack_start(d, False, False, 0)
        boton.add(interior)

        boton.connect("clicked", lambda _w: self._lanzar(cmd))
        return boton

    def _lanzar(self, cmd):
        try:
            subprocess.Popen(cmd)
        except FileNotFoundError:
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK,
                text="No se encontro %s en el sistema." % cmd[0])
            dialogo.run()
            dialogo.destroy()

    def _alternar_autostart(self, boton):
        if boton.get_active():
            if os.path.exists(AUTOSTART):
                os.remove(AUTOSTART)
        else:
            origen = "/usr/share/applications/meridian-welcome.desktop"
            if os.path.exists(origen) and not os.path.exists(AUTOSTART):
                os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
                with open(origen) as f_in, open(AUTOSTART, "w") as f_out:
                    f_out.write(f_in.read())


if __name__ == "__main__":
    Welcome().show_all()
    Gtk.main()
